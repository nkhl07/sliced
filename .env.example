# Copy this file to .env and fill in your values
# NEVER commit .env to git — it contains real secrets

# ── Anthropic (for text chat at /ordering/text) ───────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Vapi (for voice ordering at /ordering) ────────────────────────────────────
# Get your Public Key from: https://dashboard.vapi.ai → Account → API Keys
NEXT_PUBLIC_VAPI_PUBLIC_KEY="your-vapi-public-key"

# Your app's public URL — Vapi needs this to call your tool webhook
#   Local dev:  run `ngrok http 3000` and paste the https URL here
#   Production: your Vercel / Railway URL
NEXT_PUBLIC_APP_URL="https://your-ngrok-or-deployed-url.com"

# Optional: Webhook secret to verify Vapi calls (any random string)
VAPI_WEBHOOK_SECRET=""

# ── Optional branding ─────────────────────────────────────────────────────────
NEXT_PUBLIC_RESTAURANT_NAME="The Olive Branch"
NEXT_PUBLIC_RESTAURANT_TAGLINE="Fine Mediterranean Dining"
